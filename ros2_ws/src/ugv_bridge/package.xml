<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_bridge</name>
  <version>0.1.0</version>
  <description>
    Robot-side ROS 2 package for path_plannig_pfc. Subscribes to the
    annotated path image (sensor_msgs/Image) and the computed path
    (nav_msgs/Path) published by the path-planning system's ros_bridge
    module, and drives a simulated UGV (e.g. in Gazebo) along the
    received waypoints.
  </description>
  <maintainer email="you@example.com">path_plannig_pfc</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <!-- NOTE: jackal_bridge.launch.py can optionally start the Jackal (J100)
       Gazebo simulation via the `clearpath_gz` package. It is intentionally
       NOT declared as an exec_depend here (not a hard build/runtime
       dependency of this package, and its rosdep key may not resolve on
       every distro) — install it separately, see
       https://github.com/clearpathrobotics/clearpath_simulator
       (clone the branch matching your ROS distro, e.g. `humble`). -->


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
